# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://raphaelmilanramos@localhost:5432/helpdesk?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174"

SEED_ADMIN_EMAIL="admin@example.com"
# Must be changed before running seed script (min 16 characters)
SEED_ADMIN_PASSWORD="CHANGE_ME_use_a_strong_password"
SEED_ADMIN_NAME="Admin"

# Gmail API — run `bun run gmail:setup` to obtain these
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=projects/YOUR_GCP_PROJECT/topics/gmail-push
# Generate with: openssl rand -hex 16
GMAIL_WEBHOOK_SECRET=
